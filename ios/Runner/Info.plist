<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>bn</string>
		<string>en</string>
		<string>hi</string>
		<string>gu</string>
		<string>raj</string>
		<string>kn</string>
		<string>ml</string>
		<string>mr</string>
		<string>pa</string>
		<string>ta</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Resonate</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>resonate</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Resonate needs access to your photos so you can choose a profile picture and cover art for the stories and chapters you publish.</string>
	<key>NSCameraUsageDescription</key>
	<string>Resonate needs access to your camera so you can take a new profile picture without leaving the app.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Resonate needs access to your microphone so you can speak in live audio rooms, pair chats and calls with friends, and record story chapters.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Resonate needs access to your media library so you can upload an existing audio file as a story chapter.</string>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Live rooms and calls keep playing while the app is backgrounded. -->
		<string>audio</string>
		<!-- Required by firebase_messaging to handle notifications in the
		     background; without it social and room alerts are dropped. -->
		<string>remote-notification</string>
		<!-- "voip" is deliberately NOT declared yet. flutter_callkit_incoming
		     needs it, but App Review rejects a background mode the app does not
		     actually use, and the iOS side is not wired up: AppDelegate has no
		     PushKit registration and there is no VoIP Services certificate. Add
		     it in the same change that implements those, not before. -->
	</array>
</dict>
</plist>
